{
  "openapi": "3.1.0",
  "info": {
    "title": "shiro API",
    "description": "Utoipa's axum bindings for seamless integration for the two",
    "contact": {
      "name": "Juha Kukkonen",
      "email": "juha7kukkonen@gmail.com"
    },
    "license": {
      "name": "MIT OR Apache-2.0",
      "identifier": "MIT OR Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/app/startup": {
      "get": {
        "tags": [
          "app"
        ],
        "summary": "启动状态。当前无后台初始化流程，直接返回 ready；\n后续加入初始化流程后按 starting → ready/error 流转。",
        "operationId": "startup",
        "responses": {
          "200": {
            "description": "启动状态",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartupResponse"
                }
              }
            }
          },
          "401": {
            "description": "未鉴权"
          }
        },
        "security": [
          {
            "bearer_token": []
          }
        ]
      }
    },
    "/api/v1/projects": {
      "get": {
        "tags": [
          "projects"
        ],
        "summary": "项目列表（history.toml 记录，最近打开在前）",
        "operationId": "list_projects",
        "responses": {
          "200": {
            "description": "项目列表",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectListResponse"
                }
              }
            }
          },
          "401": {
            "description": "未鉴权"
          }
        },
        "security": [
          {
            "bearer_token": []
          }
        ]
      },
      "post": {
        "tags": [
          "projects"
        ],
        "summary": "新建项目：把选中的已有文件夹登记为项目（VSCode「打开文件夹」式），并导入记录。\n项目显示名写入 .shiro/project.toml 的 name（与文件夹名解耦）；留空则保留已有或用文件夹名。",
        "operationId": "create_project",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProjectRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "已创建",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectItem"
                }
              }
            }
          },
          "400": {
            "description": "参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "写入失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer_token": []
          }
        ]
      },
      "delete": {
        "tags": [
          "projects"
        ],
        "summary": "删除项目记录（只从 history.toml 移除，不删除文件夹本身）",
        "operationId": "remove_project",
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "description": "要移除记录的项目路径（只删记录，不删文件夹）",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "已删除"
          },
          "401": {
            "description": "未鉴权"
          }
        },
        "security": [
          {
            "bearer_token": []
          }
        ]
      }
    },
    "/api/v1/projects/dir": {
      "post": {
        "tags": [
          "projects"
        ],
        "summary": "新建目录（幂等：已存在返回 200）",
        "operationId": "create_project_dir",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDirRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "目录已存在"
          },
          "201": {
            "description": "已创建"
          },
          "400": {
            "description": "路径非法",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "未鉴权"
          }
        },
        "security": [
          {
            "bearer_token": []
          }
        ]
      },
      "delete": {
        "tags": [
          "projects"
        ],
        "summary": "删除目录：空目录直接删除；非空目录移入项目回收站（.shiro/trash/，可手动恢复）",
        "operationId": "remove_project_dir",
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "description": "项目根目录绝对路径",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dir",
            "in": "path",
            "description": "项目内相对路径（不允许根目录与 .shiro）",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "已删除"
          },
          "400": {
            "description": "路径非法或受保护",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "未鉴权"
          },
          "404": {
            "description": "目录不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer_token": []
          }
        ]
      }
    },
    "/api/v1/projects/entry/rename": {
      "post": {
        "tags": [
          "projects"
        ],
        "summary": "重命名项目内条目（文件或目录）：同目录改名",
        "operationId": "rename_entry",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenameEntryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "已重命名"
          },
          "400": {
            "description": "路径非法或受保护",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "未鉴权"
          },
          "404": {
            "description": "条目不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "目标已存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer_token": []
          }
        ]
      }
    },
    "/api/v1/projects/excerpts": {
      "get": {
        "tags": [
          "projects"
        ],
        "summary": "目录内全部文稿的正文预览（每篇取开头几行，Ulysses 式列表）",
        "operationId": "project_excerpts",
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "description": "项目根目录绝对路径",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dir",
            "in": "path",
            "description": "项目内相对路径（'' = 项目根）",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "预览列表",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExcerptsResponse"
                }
              }
            }
          },
          "400": {
            "description": "路径非法",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "未鉴权"
          }
        },
        "security": [
          {
            "bearer_token": []
          }
        ]
      }
    },
    "/api/v1/projects/file": {
      "get": {
        "tags": [
          "projects"
        ],
        "summary": "读取文稿内容",
        "operationId": "read_project_file",
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "description": "项目根目录绝对路径",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "file",
            "in": "path",
            "description": "项目内相对路径（如 正文/第一卷/001 序章.md）",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "文稿内容",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileContent"
                }
              }
            }
          },
          "400": {
            "description": "路径非法",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "未鉴权"
          },
          "404": {
            "description": "文件不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer_token": []
          }
        ]
      },
      "put": {
        "tags": [
          "projects"
        ],
        "summary": "保存文稿：同目录临时文件 + rename 原子覆盖，写入中断不腐蚀已有正文（见 storage.md 备份与快照）",
        "operationId": "write_project_file",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WriteFileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "已保存，返回新修改时间",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileContent"
                }
              }
            }
          },
          "400": {
            "description": "路径非法",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "未鉴权"
          },
          "500": {
            "description": "写入失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer_token": []
          }
        ]
      },
      "post": {
        "tags": [
          "projects"
        ],
        "summary": "新建文稿（空文件）",
        "operationId": "create_project_file",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "已创建",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileContent"
                }
              }
            }
          },
          "400": {
            "description": "路径非法",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "未鉴权"
          },
          "409": {
            "description": "文件已存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer_token": []
          }
        ]
      },
      "delete": {
        "tags": [
          "projects"
        ],
        "summary": "删除文稿：移入项目回收站（.shiro/trash/，可手动恢复）",
        "operationId": "remove_project_file",
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "description": "项目根目录绝对路径",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "file",
            "in": "path",
            "description": "文稿相对路径",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "已删除（移入回收站）"
          },
          "400": {
            "description": "路径非法",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "未鉴权"
          },
          "404": {
            "description": "文件不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer_token": []
          }
        ]
      }
    },
    "/api/v1/projects/rename": {
      "post": {
        "tags": [
          "projects"
        ],
        "summary": "重命名项目：重命名项目文件夹本体，history.toml 记录同步更新",
        "operationId": "rename_project",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenameProjectRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "已重命名",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectItem"
                }
              }
            }
          },
          "400": {
            "description": "名称非法",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "未鉴权"
          },
          "404": {
            "description": "项目目录不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "目标目录已存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer_token": []
          }
        ]
      }
    },
    "/api/v1/projects/tree": {
      "get": {
        "tags": [
          "projects"
        ],
        "summary": "项目目录树（目录与文稿文件；目录在前，文件名排序）",
        "operationId": "project_tree",
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "description": "项目根目录绝对路径",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "目录树",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TreeResponse"
                }
              }
            }
          },
          "400": {
            "description": "项目目录不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "未鉴权"
          }
        },
        "security": [
          {
            "bearer_token": []
          }
        ]
      }
    },
    "/api/v1/projects/watch": {
      "get": {
        "tags": [
          "projects"
        ],
        "summary": "监听项目目录变动：SSE 推送防抖 300ms 后的变更相对路径集合（`.` 开头路径段与临时文件已过滤）。\n每帧 data 为 JSON：`{\"changed\":[\"正文/a.md\"]}`；changed 为空数组表示事件滞后溢出，订阅方应全量刷新。\n鉴权走 `?key=` 查询参数（EventSource 无法自定义 header）。监听随连接建立而启动、所有订阅断开后停止。",
        "operationId": "watch_project",
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "description": "项目根目录绝对路径",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SSE 事件流（text/event-stream）：data 为 {\"changed\":[...]}；鉴权走 ?key= 查询参数"
          },
          "400": {
            "description": "项目目录不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "未鉴权"
          }
        },
        "security": [
          {
            "bearer_token": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CreateDirRequest": {
        "type": "object",
        "required": [
          "path",
          "dir"
        ],
        "properties": {
          "dir": {
            "type": "string",
            "description": "项目内相对路径（多级自动创建）"
          },
          "path": {
            "type": "string",
            "description": "项目根目录绝对路径"
          }
        }
      },
      "CreateFileRequest": {
        "type": "object",
        "required": [
          "path",
          "file"
        ],
        "properties": {
          "file": {
            "type": "string",
            "description": "项目内相对路径（父目录自动创建）"
          },
          "path": {
            "type": "string",
            "description": "项目根目录绝对路径"
          }
        }
      },
      "CreateProjectRequest": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "项目显示名（选填；写入 .shiro/project.toml 的 name，留空则保留已有或用文件夹名）"
          },
          "path": {
            "type": "string",
            "description": "项目文件夹绝对路径（须已存在；任意内容的文件夹均可）"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "ExcerptsResponse": {
        "type": "object",
        "required": [
          "excerpts"
        ],
        "properties": {
          "excerpts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SheetExcerpt"
            }
          }
        }
      },
      "FileContent": {
        "type": "object",
        "required": [
          "content",
          "modified"
        ],
        "properties": {
          "content": {
            "type": "string"
          },
          "modified": {
            "type": "integer",
            "format": "int64",
            "description": "修改时间（epoch 秒）",
            "minimum": 0
          }
        }
      },
      "ProjectItem": {
        "type": "object",
        "required": [
          "path",
          "name",
          "exists"
        ],
        "properties": {
          "exists": {
            "type": "boolean",
            "description": "目录当前是否存在（已移动/删除的历史项返回 false，前端置灰）"
          },
          "name": {
            "type": "string",
            "description": "显示名（目录 basename）"
          },
          "path": {
            "type": "string",
            "description": "项目文件夹绝对路径"
          }
        }
      },
      "ProjectListResponse": {
        "type": "object",
        "required": [
          "projects"
        ],
        "properties": {
          "projects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectItem"
            }
          }
        }
      },
      "RenameEntryRequest": {
        "type": "object",
        "required": [
          "path",
          "rel",
          "new_name"
        ],
        "properties": {
          "new_name": {
            "type": "string",
            "description": "新名字（文件名含后缀）"
          },
          "path": {
            "type": "string",
            "description": "项目根目录绝对路径"
          },
          "rel": {
            "type": "string",
            "description": "条目相对路径（文件或目录；文件需含后缀）"
          }
        }
      },
      "RenameProjectRequest": {
        "type": "object",
        "required": [
          "path",
          "new_name"
        ],
        "properties": {
          "new_name": {
            "type": "string",
            "description": "新名称（即新目录名）"
          },
          "path": {
            "type": "string",
            "description": "项目当前绝对路径"
          }
        }
      },
      "SheetExcerpt": {
        "type": "object",
        "required": [
          "file",
          "excerpt"
        ],
        "properties": {
          "excerpt": {
            "type": "string",
            "description": "正文预览（markdown 剥离标记后取开头约 160 字；纯文本直接取开头）"
          },
          "file": {
            "type": "string",
            "description": "文稿在项目内的相对路径"
          }
        }
      },
      "StartupResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "$ref": "#/components/schemas/StartupStatus"
          }
        }
      },
      "StartupStatus": {
        "type": "string",
        "enum": [
          "starting",
          "ready",
          "error"
        ]
      },
      "TreeNode": {
        "type": "object",
        "required": [
          "name",
          "path",
          "kind"
        ],
        "properties": {
          "children": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/TreeNode"
            },
            "description": "子节点（仅 dir）"
          },
          "kind": {
            "type": "string",
            "description": "dir / file"
          },
          "modified": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "文件修改时间（epoch 秒，仅 file）",
            "minimum": 0
          },
          "name": {
            "type": "string",
            "description": "节点名（文件含 .md/.markdown/.txt 后缀）"
          },
          "path": {
            "type": "string",
            "description": "项目内相对路径"
          }
        }
      },
      "TreeResponse": {
        "type": "object",
        "required": [
          "children"
        ],
        "properties": {
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TreeNode"
            }
          }
        }
      },
      "WriteFileRequest": {
        "type": "object",
        "required": [
          "path",
          "file",
          "content"
        ],
        "properties": {
          "content": {
            "type": "string"
          },
          "file": {
            "type": "string",
            "description": "项目内相对路径"
          },
          "path": {
            "type": "string",
            "description": "项目根目录绝对路径"
          }
        }
      }
    },
    "securitySchemes": {
      "bearer_token": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
